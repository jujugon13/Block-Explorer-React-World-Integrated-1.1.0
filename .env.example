# PostgreSQL 18.3 + pgvector 0.8.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vectorshelf
DB_USER=vectorshelf
DB_PASSWORD=replace-with-database-password

# Redis (compose.yml uses REDIS_PASSWORD; the application reads REDIS_URL)
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/0

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key

# Application
VECTORSHELF_JWT__SECRET=replace-with-a-long-random-secret
VECTORSHELF_SERVER__PORT=8080
VECTORSHELF_STORAGE__TYPE=local
VECTORSHELF_STORAGE__LOCAL__ROOT=./data/vectorshelf
VECTORSHELF_INDEXING__WORKER__ENABLED=true
VECTORSHELF_SYNC__DISPATCHER__ENABLED=true

# Optional comma-separated browser origins for production CORS and WebSocket.
# CORS_ALLOWED_ORIGINS=https://vectorshelf.example.com

# Optional: keep the Hugging Face model cache outside this repository.
# HF_HOME=/absolute/path/outside/vectorshelf

# Optional AWS S3 storage. Also set VECTORSHELF_STORAGE__TYPE=s3.
# S3_BUCKET=replace-with-bucket-name
# AWS_DEFAULT_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
